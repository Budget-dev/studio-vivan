rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      // Universal override for the master admin email
      return isSignedIn() && request.auth.token.email == 'vivanfarmsnatural@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- 1. Public Storefront Access (Read-Only for Everyone) ---
    // Explicitly allow guests to browse the catalog without login.

    match /categories/{categoryId} {
      allow read: if true;
    }

    match /products/{productId} {
      allow read: if true;
      
      match /variants/{variantId} {
        allow read: if true;
      }
    }

    match /combos/{comboId} {
      allow read: if true;
    }

    match /universalCoupons/{couponId} {
      allow read: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // --- 2. Private User and Order Rules (Authenticated Only) ---

    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      // Lists are restricted to ensure privacy and performance
      allow list: if isSignedIn() && request.query.limit <= 100;
    }

    match /adminRoles/{uid} {
      allow get: if isSignedIn();
      allow write: if isMasterAdmin();
    }

    // --- 3. Universal Master Access ---
    // Grants absolute power to the master admin across ALL collections as a fallback
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }
  }
}