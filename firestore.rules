rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'vivanfarmsnatural@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- 1. Public Storefront Access ---
    // Using {id=**} ensures that both individual documents (get) 
    // and collection listings (list) are permitted even for anonymous users.

    match /categories/{id=**} {
      allow read: if true;
    }

    match /products/{id=**} {
      allow read: if true;
    }

    match /combos/{id=**} {
      allow read: if true;
    }

    match /universalCoupons/{id=**} {
      allow read: if true;
    }

    match /reviews/{id=**} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // --- 2. Private User and Order Rules ---

    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && request.query.limit <= 100;
    }

    match /adminRoles/{uid} {
      allow get: if isSignedIn();
      allow write: if isMasterAdmin();
    }

    // --- 3. Universal Master Admin Access ---
    // Catch-all for administrative operations
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }
  }
}
