rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'vivanfarmsnatural@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- 1. Public Storefront Access (Top Priority) ---
    // These rules allow anyone (guest or logged-in) to browse the catalog.
    // We use explicit get/list to ensure filtered queries match correctly.

    match /categories/{docId=**} {
      allow get, list: if true;
    }

    match /products/{docId=**} {
      allow get, list: if true;
    }

    match /combos/{docId=**} {
      allow get, list: if true;
    }

    match /universalCoupons/{docId=**} {
      allow get, list: if true;
    }

    match /reviews/{docId=**} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // --- 2. Private User and Order Rules ---

    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && request.query.limit <= 100;
    }

    match /adminRoles/{uid} {
      allow get: if isSignedIn();
      allow write: if isMasterAdmin();
    }

    // --- 3. Universal Master Admin Access ---
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }
  }
}